---
import BaseLayout from './BaseLayout.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import type { Project } from '@/data/projects';
import { withBase } from '@/data/site';

interface Props { project: Project; previous?: Project; next?: Project; }
const { project, previous, next } = Astro.props;
const title = `${project.title} — Aaditya Bhatnagar`;
const description = project.longDescription;
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.longDescription,
  author: { '@type': 'Person', name: 'Aaditya Bhatnagar' },
  keywords: project.technologies.join(', '),
};
---

<BaseLayout title={title} description={description} type="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  <section class="detail-hero shell">
    <span class="eyebrow">{project.category}</span>
    <h1>{project.title}</h1>
    {project.subtitle && <p class="detail-subtitle">{project.subtitle}</p>}
    <p class="detail-summary">{project.longDescription}</p>
    <div class="detail-meta">
      {project.role && <div class="detail-meta-item"><span>Role</span><span>{project.role}</span></div>}
      {project.dates && <div class="detail-meta-item"><span>Date</span><span>{project.dates}</span></div>}
      <div class="detail-meta-item"><span>Technology</span><span>{project.technologies.slice(0, 5).join(' · ')}</span></div>
    </div>
  </section>
  <div class="detail-layout shell">
    <aside class="detail-aside">
      <ProjectVisual type={project.visualType} label={project.category} />
      <ul class="tag-list" aria-label={`${project.title} technologies`}>
        {project.technologies.map((technology) => <li class="tag">{technology}</li>)}
      </ul>
      <div class="project-links" style="margin-top: 1rem;">
        {project.liveUrl && <a class="text-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">Live site</a>}
        {project.repositoryUrl && <a class="text-link" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">Repository</a>}
        {project.reportUrl && <a class="text-link" href={project.reportUrl} target="_blank" rel="noopener noreferrer">Report</a>}
      </div>
    </aside>
    <article class="detail-body">
      {(project.sections ?? []).map((section) => (
        <section class="detail-section">
          <h2>{section.title}</h2>
          <p>{section.body}</p>
          {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
        </section>
      ))}
      <section class="detail-section">
        <h2>Reported results</h2>
        <div class="detail-results">
          {project.metrics.map((metric) => <div class="detail-result">{metric}</div>)}
        </div>
      </section>
      <nav class="detail-nav" aria-label="Project navigation">
        {previous ? <a href={withBase(`/projects/${previous.slug}/`)}><small>Previous project</small><strong>← {previous.title}</strong></a> : <span></span>}
        {next ? <a href={withBase(`/projects/${next.slug}/`)}><small>Next project</small><strong>{next.title} →</strong></a> : <a href={withBase('/projects/')}><small>Archive</small><strong>All projects →</strong></a>}
      </nav>
    </article>
  </div>
</BaseLayout>
