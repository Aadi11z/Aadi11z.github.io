---
import BaseLayout from './BaseLayout.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import UnlearningExplorer from '@/components/playgrounds/UnlearningExplorer.astro';
import type { Project } from '@/data/projects';
import { profile } from '@/data/profile';
import { siteConfig, withBase } from '@/data/site';
import '@/styles/projects.css';

interface Props { project: Project; previous?: Project; next?: Project; }
const { project, previous, next } = Astro.props;
const detail = project.detail;
if (!detail) throw new Error(`Project ${project.slug} does not have detail content.`);
const title = `${project.title} — Aaditya Bhatnagar`;
const description = project.longDescription;
const projectUrl = new URL(withBase(`/projects/${project.slug}/`), siteConfig.url).toString();
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.longDescription,
  url: projectUrl,
  author: { '@type': 'Person', name: profile.name },
  keywords: project.technologies.join(', '),
  ...(project.liveUrl ? { sameAs: project.liveUrl } : {}),
};
const transitionStyle = `--project-title-vt: project-${project.slug}; --project-visual-vt: visual-${project.slug};`;
let sectionIndex = 0;
const nextIndex = () => String(++sectionIndex).padStart(2, '0');
---

<BaseLayout title={title} description={description} type="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  <section class="detail-hero shell" style={transitionStyle}>
    <a class="detail-back" href={withBase('/projects/')}><span aria-hidden="true">←</span> Project archive</a>
    <div class="detail-hero-grid">
      <div class="detail-intro" data-reveal>
        <span class="eyebrow">Case file / {project.category}</span>
        <h1>{project.title}</h1>
        {project.subtitle && <p class="detail-subtitle">{project.subtitle}</p>}
        <p class="detail-summary">{project.longDescription}</p>
      </div>
      <div data-reveal><ProjectVisual type={project.visualType} label={project.category} title={`${project.title} architecture motif`} /></div>
    </div>
    <div class="detail-meta" aria-label="Project metadata">
      <div class="detail-meta-item"><span>{project.role ? 'Status' : 'Focus'}</span><span>{project.role ?? project.category}</span></div>
      <div class="detail-meta-item"><span>Date</span><span>{project.dates ?? 'Date not supplied'}</span></div>
      <div class="detail-meta-item"><span>Technology</span><span>{project.technologies.join(' · ')}</span></div>
    </div>
  </section>

  <div class="detail-layout shell">
    <aside class="detail-aside">
      <span class="eyebrow">Reported evidence</span>
      <div class="detail-results">{project.metrics.map((metric, index) => <div class="detail-result"><span>0{index + 1}</span>{metric}</div>)}</div>
      {(project.liveUrl || project.repositoryUrl || project.reportUrl) && <div class="detail-links">
        <span class="eyebrow">Links</span>
        {project.liveUrl && <a class="text-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">Live site</a>}
        {project.repositoryUrl && <a class="text-link" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">Repository</a>}
        {project.reportUrl && <a class="text-link" href={project.reportUrl} target="_blank" rel="noopener noreferrer">Report</a>}
      </div>}
    </aside>

    <article class="detail-body">
      <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Problem</h2><p>{detail.problem}</p></section>
      {detail.architecture && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Architecture</h2><p>{detail.architecture}</p></section>}
      {detail.technicalDecisions && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Technical decisions</h2><ul>{detail.technicalDecisions.map((item) => <li>{item}</li>)}</ul></section>}
      {detail.pipeline && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Data and model pipeline</h2><ol class="pipeline-list">{detail.pipeline.map((item) => <li>{item}</li>)}</ol></section>}
      {project.explorer === 'unlearning' && <UnlearningExplorer />}
      {detail.evaluation && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Evaluation</h2><p>{detail.evaluation}</p></section>}
      {detail.results && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Results</h2><p>{detail.results}</p></section>}
      {detail.limitations && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Limitations</h2><p>{detail.limitations}</p></section>}
      {detail.lessons && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Lessons learned</h2><p>{detail.lessons}</p></section>}
      {detail.futureWork && <section class="detail-section" data-reveal><span class="detail-section-index meta">{nextIndex()}</span><h2>Future work</h2><p>{detail.futureWork}</p></section>}
      <nav class="detail-nav" aria-label="Project navigation">
        {previous ? <a href={withBase(`/projects/${previous.slug}/`)}><small>Previous case</small><strong>← {previous.title}</strong></a> : <span></span>}
        {next ? <a href={withBase(`/projects/${next.slug}/`)}><small>Next case</small><strong>{next.title} →</strong></a> : <a href={withBase('/projects/')}><small>Project index</small><strong>All projects →</strong></a>}
      </nav>
    </article>
  </div>
</BaseLayout>
