---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { profile } from '@/data/profile';
import { siteConfig, withBase } from '@/data/site';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/layout.css';
import '@/styles/effects.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  layout?: 'document' | 'deck';
}

const {
  title = 'Aaditya Bhatnagar — ML Engineer, Data Scientist and AI Researcher',
  description = 'Portfolio of Aaditya Bhatnagar, a Dubai-based computer science student building machine-learning systems, grounded AI products, quantitative research platforms, and machine-unlearning research.',
  type = 'website',
  noindex = false,
  layout = 'document',
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalPath = siteConfig.basePath && (currentPath === siteConfig.basePath || currentPath.startsWith(`${siteConfig.basePath}/`))
  ? currentPath
  : withBase(currentPath);
const canonical = new URL(canonicalPath, siteConfig.url).toString();
const imageUrl = new URL(withBase('/og-image.png'), siteConfig.url).toString();
const siteRoot = new URL(withBase('/'), siteConfig.url).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: siteRoot,
  email: `mailto:${profile.email}`,
  jobTitle: 'ML Engineer and Data Scientist',
  address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'BITS Pilani, Dubai Campus' },
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f0e7" data-theme-color />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aaditya Bhatnagar Editorial Manga Lab portfolio card" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const theme = savedTheme === 'dark' || savedTheme === 'light'
            ? savedTheme
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const savedMotion = localStorage.getItem('motion');
          const motion = savedMotion === 'full' || savedMotion === 'reduced'
            ? savedMotion
            : (window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full');
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.motion = motion;
          document.querySelector('[data-theme-color]')?.setAttribute('content', theme === 'dark' ? '#0d121b' : '#f4f0e7');
        } catch {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.dataset.motion = 'reduced';
        }
      })();
    </script>
  </head>
  <body data-layout={layout}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/effects';
    </script>
  </body>
</html>
