---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { profile } from '@/data/profile';
import { introMode, introSessionKey, siteConfig, withBase } from '@/data/site';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/layout.css';
import '@/styles/effects.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  layout?: 'document' | 'deck';
}

const {
  title = 'Aaditya Bhatnagar — ML Engineer, Data Scientist and AI Researcher',
  description = 'Portfolio of Aaditya Bhatnagar, a Dubai-based ML engineer and data scientist building reliable AI products, quantitative research platforms, and machine-learning systems.',
  type = 'website',
  noindex = false,
  layout = 'document',
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalPath = siteConfig.basePath && (currentPath === siteConfig.basePath || currentPath.startsWith(`${siteConfig.basePath}/`))
  ? currentPath
  : withBase(currentPath);
const canonical = new URL(canonicalPath, siteConfig.url).toString();
const imageUrl = new URL(withBase('/og-image.png'), siteConfig.url).toString();
const siteRoot = new URL(withBase('/'), siteConfig.url).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: siteRoot,
  email: `mailto:${profile.email}`,
  jobTitle: 'ML Engineer and Data Scientist',
  address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang="en" data-intro-session-key={introSessionKey} data-intro-mode={introMode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#efe8d1" data-theme-color />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aaditya Bhatnagar professional portfolio card" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <noscript><style>.hero-intro { display: none !important; }</style></noscript>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let savedTheme = null;
        let introSeen = false;
        let internalHandoff = false;
        try {
          savedTheme = localStorage.getItem('theme');
          const introKey = root.dataset.introSessionKey;
          introSeen = introKey ? sessionStorage.getItem(introKey) === 'seen' : false;
          const handoffKey = introKey ? `${introKey}:handoff` : '';
          const handoff = handoffKey ? JSON.parse(sessionStorage.getItem(handoffKey) || 'null') : null;
          const currentTarget = `${location.pathname}${location.search}${location.hash}`;
          internalHandoff = Boolean(handoff && handoff.target === currentTarget && Date.now() - handoff.at < 15_000);
          if (handoffKey) sessionStorage.removeItem(handoffKey);
        } catch { /* Storage may be disabled. */ }

        const theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const requestedSection = decodeURIComponent(window.location.hash.slice(1));
        const currentUrl = new URL(window.location.href);
        const explicitSkip = currentUrl.searchParams.get('intro') === 'skip';
        const deepLink = Boolean(requestedSection && requestedSection !== 'overview');
        const navigation = performance.getEntriesByType('navigation')[0];
        const navigationType = navigation && 'type' in navigation ? navigation.type : 'unknown';
        const historyRestoreWasNotRestored = navigationType === 'back_forward'
          && 'notRestoredReasons' in navigation
          && navigation.notRestoredReasons !== null;
        const designMode = root.dataset.introMode === 'design';
        let introVisit = 'returning';
        if (designMode || (!introSeen && !explicitSkip && !deepLink)) introVisit = 'first';
        else if (!explicitSkip && !deepLink && !internalHandoff && navigationType === 'navigate') introVisit = 'first';
        else if (!explicitSkip && !deepLink && !internalHandoff && navigationType === 'back_forward' && !historyRestoreWasNotRestored) introVisit = 'first';
        root.dataset.theme = theme;
        root.dataset.introVisit = introVisit;
        root.dataset.heroIntroState = root.dataset.introVisit === 'first' ? 'active' : 'entered';
        document.querySelector('[data-theme-color]')?.setAttribute('content', theme === 'dark' ? '#05080e' : '#efe8d1');
        if (explicitSkip) {
          try {
            const introKey = root.dataset.introSessionKey;
            if (root.dataset.introMode !== 'design' && introKey) sessionStorage.setItem(introKey, 'seen');
          } catch { /* Storage may be disabled. */ }
          currentUrl.searchParams.delete('intro');
          window.history.replaceState(null, '', `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`);
        }
      })();
    </script>
  </head>
  <body data-layout={layout}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.addEventListener('click', (event) => {
        if (!(event instanceof MouseEvent) || event.button !== 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!(link instanceof HTMLAnchorElement) || (link.target && link.target !== '_self') || link.hasAttribute('download')) return;
        const target = new URL(link.href, location.href);
        if (target.origin !== location.origin) return;
        if (target.pathname === location.pathname && target.search === location.search) return;
        try {
          const introKey = document.documentElement.dataset.introSessionKey;
          if (!introKey) return;
          sessionStorage.setItem(`${introKey}:handoff`, JSON.stringify({
            target: `${target.pathname}${target.search}${target.hash}`,
            at: Date.now(),
          }));
        } catch { /* Storage may be disabled. */ }
      });
    </script>
    <script>
      import '@/scripts/effects';
    </script>
  </body>
</html>
