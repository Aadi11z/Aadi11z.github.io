---
import type { Project } from '@/data/projects';
import GroundDeskVisual from './visuals/GroundDeskVisual.astro';
import MLPVisual from './visuals/MLPVisual.astro';
import MarketVisual from './visuals/MarketVisual.astro';
import LensVisual from './visuals/LensVisual.astro';
import UnlearningVisual from './visuals/UnlearningVisual.astro';
import AdversarialVisual from './visuals/AdversarialVisual.astro';

interface Props { type: Project['visualType']; label?: string; title?: string; }
const { type, label, title = 'Technical project diagram' } = Astro.props;
---

<figure class:list={['project-visual', `visual-${type}`, 'manga-panel']} aria-label={title}>
  <div class="visual-code meta"><span>AB / {type.toUpperCase()}</span><span>TECH NOTE</span></div>
  <div class="project-visual-canvas" aria-hidden="true">
    {type === 'grounddesk' && <GroundDeskVisual />}
    {type === 'mlp' && <MLPVisual />}
    {(type === 'nrg' || type === 'qnt') && <MarketVisual mode={type} />}
    {type === 'deeplense' && <LensVisual />}
    {type === 'unlearning' && <UnlearningVisual />}
    {type === 'adversarial' && <AdversarialVisual />}
  </div>
  <figcaption class="visual-footer">
    {label && <span class="project-visual-label meta">{label}</span>}
    <span class="visual-status meta"><span aria-hidden="true">●</span> Case file</span>
  </figcaption>
</figure>
