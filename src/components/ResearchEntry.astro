---
import type { ResearchEntryData } from '@/data/research';
import { withBase } from '@/data/site';
type Entry = ResearchEntryData;
interface Props { entry: Entry; }
const { entry } = Astro.props;
---

<article class="research-entry">
  <div class="research-meta">
    <strong>{entry.status}</strong>
    <span class="meta">{entry.dates}</span>
  </div>
  <div class="research-content">
    <h3>{entry.title}</h3>
    <ul class="tag-list" aria-label={`${entry.title} technologies`}>
      {entry.technology.map((item) => <li class="tag">{item}</li>)}
    </ul>
    <p class="research-abstract">{entry.abstract}</p>
    <div class="research-notes">
      <p><strong>Methods</strong><span>{entry.methods}</span></p>
      <p><strong>Evaluation</strong><span>{entry.evaluation}</span></p>
    </div>
    <p class="result"><strong>Result</strong><span>{entry.result}</span></p>
    {entry.detailSlug && <a class="text-link research-link" href={withBase(`/projects/${entry.detailSlug}/`)}>Read the research brief</a>}
  </div>
</article>
