---
import { profile } from '@/data/profile';
import { withBase } from '@/data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const homePath = withBase('/');
const link = (section: string) => path === homePath || path === `${homePath}/` ? `#${section}` : `${homePath}#${section}`;
const resumePath = withBase('/resume/');
const onResume = path === resumePath || path === resumePath.replace(/\/$/, '');
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={homePath} aria-label={`${profile.name} home`}>
      <span class="wordmark-mark">{profile.monogram}</span>
      <span class="wordmark-name">{profile.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class="nav-link" data-section-link="work" href={link('work')}>Work</a>
      <a class="nav-link" data-section-link="research" href={link('research')}>Research</a>
      <a class="nav-link" data-section-link="experience" href={link('experience')}>Experience</a>
      <a class="nav-link" data-section-link="about" href={link('about')}>About</a>
      <a class="nav-link" data-section-link="contact" href={link('contact')}>Contact</a>
      <a class="nav-link nav-resume" aria-current={onResume ? 'page' : undefined} href={resumePath}>Resume</a>
      <ThemeToggle />
    </nav>
    <div class="mobile-actions">
      <ThemeToggle />
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" data-menu-toggle>
        <svg class="icon menu-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="icon menu-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav shell" id="mobile-navigation" aria-label="Mobile navigation" data-mobile-nav data-open="false">
    <a href={link('work')}>Work</a>
    <a href={link('research')}>Research</a>
    <a href={link('experience')}>Experience</a>
    <a href={link('about')}>About</a>
    <a href={link('contact')}>Contact</a>
    <a class="mobile-resume" href={resumePath}>Resume</a>
  </nav>
</header>

<script>
  const menuButton = document.querySelector('[data-menu-toggle]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  const firstMobileLink = mobileNav?.querySelector('a');
  let lastFocusedElement: HTMLElement | null = null;
  const setMenu = (open: boolean) => {
    mobileNav?.setAttribute('data-open', String(open));
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    if (open) {
      lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      firstMobileLink?.focus();
    } else {
      lastFocusedElement?.focus();
      lastFocusedElement = null;
    }
  };
  menuButton?.addEventListener('click', () => setMenu(mobileNav?.getAttribute('data-open') !== 'true'));
  mobileNav?.querySelectorAll('a').forEach((item) => item.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && mobileNav?.getAttribute('data-open') === 'true') {
      event.preventDefault();
      setMenu(false);
    }
  });

  const sectionLinks = document.querySelectorAll<HTMLElement>('[data-section-link]');
  const sections = [...sectionLinks]
    .map((item) => document.getElementById(item.dataset.sectionLink ?? ''))
    .filter((section): section is HTMLElement => Boolean(section));
  if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          sectionLinks.forEach((item) => item.removeAttribute('aria-current'));
          document.querySelector(`[data-section-link="${entry.target.id}"]`)?.setAttribute('aria-current', 'location');
        }
      });
    }, { rootMargin: '-28% 0px -62% 0px', threshold: 0 });
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .mobile-actions { display: none; align-items: center; }
  .menu-close { display: none; }
  [data-menu-toggle][aria-expanded='true'] .menu-open { display: none; }
  [data-menu-toggle][aria-expanded='true'] .menu-close { display: block; }
  @media (max-width: 820px) { .mobile-actions { display: flex; } }
</style>
