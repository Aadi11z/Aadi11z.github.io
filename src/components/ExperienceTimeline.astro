---
import { experience } from '@/data/experience';
---

<div class="experience-list">
  {experience.map((item) => (
    <article class="experience-card" data-reveal>
      <header class="experience-top">
        <span class="experience-monogram" aria-hidden="true">{item.monogram}</span>
        <div class="experience-title">
          <span class="eyebrow">{item.role}</span>
          <h3>{item.company}</h3>
          <p>{item.location} · {item.dates}</p>
        </div>
      </header>
      <div class="experience-body">
        <p class="experience-summary">{item.summary}</p>
        <ul class="experience-bullets">
          {item.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <a class="text-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">View the experience note on LinkedIn</a>
      </div>
    </article>
  ))}
</div>
