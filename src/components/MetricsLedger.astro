---
const metrics = [
  { value: '100%', label: 'GroundDesk top citation', project: 'GroundDesk', href: '/projects/grounddesk/' },
  { value: '2.24', unit: 'EUR/MWh', label: 'NRG walk-forward MAE', project: 'NRG', href: '/projects/nrg/' },
  { value: '0.9862', label: 'DeepLense mean validation AUC', project: 'DeepLense' },
  { value: '86.32%', label: 'Unlearning retain accuracy', project: 'Machine unlearning', href: '/projects/machine-unlearning-vision-language-models/' },
];
import { withBase } from '@/data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section metrics-section" aria-labelledby="metrics-title">
  <div class="shell">
    <SectionHeading id="metrics-title" index="06 / Evidence" title="Selected metrics" description="Reported signals tied to specific benchmarks and evaluation settings—not a single scorecard across unrelated projects." />
    <div class="metrics-ledger">
      {metrics.map((metric, index) => (
        <article class="ledger-metric" data-reveal>
          <span class="meta">0{index + 1} / {metric.project}</span>
          <strong>{metric.value}{metric.unit && <small>{metric.unit}</small>}</strong>
          <p>{metric.label}</p>
          {metric.href && <a class="text-link" href={withBase(metric.href)}>Read context</a>}
        </article>
      ))}
    </div>
  </div>
</section>
