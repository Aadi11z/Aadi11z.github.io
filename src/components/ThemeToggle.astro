<button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
  <svg class="icon moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z" /></svg>
  <svg class="icon sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" /></svg>
</button>

<script>
  const buttons = document.querySelectorAll('[data-theme-toggle]');
  const updateLabel = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    buttons.forEach((button) => button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme'));
  };
  buttons.forEach((button) => button.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* Storage may be disabled. */ }
    updateLabel();
  }));
  updateLabel();
</script>
