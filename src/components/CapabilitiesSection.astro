---
import { about } from '@/data/profile';
import { primaryTools, skillGroups } from '@/data/skills';
import SectionHeading from './SectionHeading.astro';
---

<section class="section shell capabilities-section" aria-labelledby="capabilities-title">
  <SectionHeading id="capabilities-title" index="05 / Capabilities" title="Technical capabilities" description="A practical toolkit for taking work from raw data and experiments to evaluated systems and usable interfaces." />
  <div class="capabilities-layout">
    <div class="primary-tool-panel manga-panel" data-reveal>
      <span class="eyebrow">Primary stack</span>
      <div class="primary-tools">{primaryTools.map((tool, index) => <span><small>0{index + 1}</small>{tool}</span>)}</div>
    </div>
    <div class="skill-groups" data-reveal>
      {skillGroups.map((group, index) => <div class="skill-group"><span class="meta">0{index + 1}</span><h3>{group.name}</h3><p>{group.items.join(' · ')}</p></div>)}
    </div>
  </div>
  <div class="principles" aria-label="Working principles">
    {about.principles.map((principle, index) => <article class="principle" data-reveal><span class="meta">NOTE / 0{index + 1}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>)}
  </div>
</section>
