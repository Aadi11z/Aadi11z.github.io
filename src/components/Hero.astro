---
import { about, profile } from '@/data/profile';
import { withBase } from '@/data/site';
import SocialLinks from './SocialLinks.astro';
import KeyboardIntro from './intro/KeyboardIntro.astro';
---

<section class="hero shell" aria-labelledby="hero-title" data-hero-gate>
  <div class="hero-intro" data-hero-intro>
    <KeyboardIntro />
  </div>

  <div class="hero-overview" data-overview-content>
    <div class="hero-rule" aria-hidden="true">
      <span>Overview / 00</span>
      <span>Professional profile / {profile.location}</span>
    </div>

    <div class="hero-layout">
      <div class="hero-main">
        <span class="eyebrow">ML / Data / Systems</span>
        <h1 id="hero-title" class="hero-name">{profile.name}</h1>
        <h2 id="overview-title" class="hero-headline">{profile.headline}</h2>
      </div>
      <div class="hero-support">
        <p class="status-line"><span aria-hidden="true">●</span> {profile.location} · Open to graduate opportunities</p>
        <p class="hero-copy">{profile.description}</p>
        <div class="button-row hero-actions">
          <a class="button button-primary" href="#projects">Explore projects <span aria-hidden="true">→</span></a>
          <a class="button button-quiet" href={withBase('/resume/')}>Résumé <span aria-hidden="true">↗</span></a>
          <a class="button button-quiet" href={`mailto:${profile.email}`}>Email <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>

    <div class="overview-brief">
      <section class="overview-about" aria-labelledby="overview-about-title">
        <span class="eyebrow">Profile</span>
        <h3 id="overview-about-title">End-to-end technical work, grounded in evidence.</h3>
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
      <aside class="overview-contact" aria-labelledby="overview-contact-title">
        <span class="eyebrow">Contact</span>
        <h3 id="overview-contact-title">Start a conversation.</h3>
        <a class="overview-email" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a>
        <SocialLinks />
      </aside>
    </div>

    <div class="hero-footnote">
      <span class="availability-dot" aria-hidden="true"></span>
      <p>{profile.availability}</p>
      <span class="meta">PROJECTS / 01</span>
    </div>
  </div>
</section>
