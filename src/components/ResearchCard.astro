---
import type { ResearchEntryData } from '@/data/research';
import { withBase } from '@/data/site';

interface Props { entry: ResearchEntryData; index: number; headingLevel?: 3 | 4; }
const { entry, index, headingLevel = 3 } = Astro.props;
const HeadingTag = headingLevel === 4 ? 'h4' : 'h3';
---

<article class="research-card" data-reveal>
  <header class="research-card-header">
    <span class="research-status">{entry.status}</span>
    <span class="meta">Research / 0{index + 1}</span>
  </header>
  <div class="research-card-body">
    <p class="meta">{entry.dates}</p>
    <HeadingTag class="research-card-title">{entry.title}</HeadingTag>
    <p class="research-card-question">{entry.question}</p>
    <dl class="research-card-evidence">
      <div><dt>Method</dt><dd>{entry.methods}</dd></div>
      <div><dt>Finding</dt><dd>{entry.result}</dd></div>
    </dl>
    <ul class="tag-list" aria-label={`${entry.title} technologies`}>
      {entry.technology.slice(0, 6).map((item) => <li class="tag">{item}</li>)}
    </ul>
  </div>
  {entry.detailSlug && <footer class="research-card-footer"><a class="text-link" href={withBase(`/projects/${entry.detailSlug}/`)}>Open research brief</a></footer>}
</article>
