---
import { profile } from '@/data/profile';
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="shell contact-grid">
    <div data-reveal>
      <span class="eyebrow">07 / Contact</span>
      <h2 id="contact-title">Let’s build<br />something <em>useful.</em></h2>
      <p class="contact-note meta">END NOTE / DUBAI / 2026</p>
    </div>
    <div class="contact-copy" data-reveal>
      <p>I’m currently preparing for graduate roles in machine learning, data science, AI research, quantitative research, and software engineering. I’m always interested in thoughtful technical work, research collaborations, and conversations about reliable AI and data-driven systems.</p>
      <a class="contact-email" href={`mailto:${profile.email}`}>Email Aaditya<span aria-hidden="true">↗</span><small>{profile.email}</small></a>
      <div class="contact-links">
        <a class="text-link" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="text-link" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </div>
</section>
