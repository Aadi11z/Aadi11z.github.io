---
import type { Project } from '@/data/projects';
import { withBase } from '@/data/site';

interface Props { project: Project; index: number; variant?: 'featured' | 'archive'; headingLevel?: 3 | 4; }
const { project, index, variant = 'featured', headingLevel = 3 } = Astro.props;
const hasCaseStudy = Boolean(project.detail);
const transitionStyle = `--project-title-vt: project-${project.slug}; --project-visual-vt: visual-${project.slug};`;
const HeadingTag = headingLevel === 4 ? 'h4' : 'h3';
---

<article
  class:list={['project-card', `project-card-${variant}`]}
  style={transitionStyle}
  data-project-card
  data-categories={project.categories.join('|')}
  data-reveal
>
  <div class="project-content">
    <header class="project-header">
      <span class="project-number">{project.category} / {String(index + 1).padStart(2, '0')}</span>
      {project.dates && <span class="meta">{project.dates}</span>}
    </header>
    <div class="project-title-row">
      <HeadingTag class="project-title">{project.title}</HeadingTag>
      <span class="project-arrow" aria-hidden="true">↗</span>
    </div>
    {project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
    <p class="project-summary">{project.summary}</p>
    {project.metrics[0] && <p class="project-signal"><span class="meta">Evidence</span>{project.metrics[0]}</p>}
    <ul class="tag-list" aria-label={`${project.title} technologies`}>
      {project.technologies.slice(0, variant === 'archive' ? 6 : 5).map((technology) => <li class="tag">{technology}</li>)}
    </ul>
    <footer class="project-footer">
      <div class="project-links">
        {hasCaseStudy && <a class="text-link" href={withBase(`/projects/${project.slug}/`)}>Read case study</a>}
        {project.liveUrl && <a class="text-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">Live site</a>}
        {project.repositoryUrl && <a class="text-link" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">Repository</a>}
        {project.reportUrl && <a class="text-link" href={project.reportUrl} target="_blank" rel="noopener noreferrer">Report</a>}
      </div>
      {!hasCaseStudy && !project.liveUrl && !project.repositoryUrl && <span class="project-private meta">Public link not supplied</span>}
      <span class="project-category meta">{project.categories.join(' · ')}</span>
    </footer>
  </div>
</article>
