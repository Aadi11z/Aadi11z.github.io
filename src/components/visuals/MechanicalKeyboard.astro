---
type KeySpec = {
  label: string;
  value: string;
  width?: number;
  symbol?: string;
};

type VectorKey = KeySpec & {
  x: number;
  y: number;
  width: number;
  height: number;
  hue: number;
};

const keyHeight = 52;
const keyGap = 6;

function layoutRow(y: number, specs: KeySpec[]): VectorKey[] {
  let x = 80;
  return specs.map((spec) => {
    const width = spec.width ?? 57;
    const key = {
      ...spec,
      x,
      y,
      width,
      height: keyHeight,
      hue: Math.round(8 + ((x - 80) / 1064) * 294),
    };
    x += width + keyGap;
    return key;
  });
}

const numberKeys: KeySpec[] = [
  { label: '1', symbol: '!', value: '1' },
  { label: '2', symbol: '@', value: '2' },
  { label: '3', symbol: '#', value: '3' },
  { label: '4', symbol: '$', value: '4' },
  { label: '5', symbol: '%', value: '5' },
  { label: '6', symbol: '^', value: '6' },
  { label: '7', symbol: '&', value: '7' },
  { label: '8', symbol: '*', value: '8' },
  { label: '9', symbol: '(', value: '9' },
  { label: '0', symbol: ')', value: '0' },
];

const keys: VectorKey[] = [
  ...layoutRow(80, [
    { label: 'Esc', value: 'escape', width: 58 },
    ...numberKeys,
    { label: '−', value: '-' },
    { label: '=', value: '=' },
    { label: 'Backspace', value: 'backspace', width: 126 },
    { label: 'Delete', value: 'delete', width: 72 },
  ]),
  ...layoutRow(140, [
    { label: 'Tab', value: 'tab', width: 86 },
    ...'QWERTYUIOP'.split('').map((label) => ({ label, value: label.toLowerCase() })),
    { label: '[', value: '[' },
    { label: ']', value: ']' },
    { label: '\\', value: '\\', width: 80 },
    { label: 'PgUp', value: 'pageup', width: 80 },
  ]),
  ...layoutRow(200, [
    { label: 'Caps Lock', value: 'capslock', width: 112 },
    ...'ASDFGHJKL'.split('').map((label) => ({ label, value: label.toLowerCase() })),
    { label: ';', value: ';' },
    { label: "'", value: "'" },
    { label: 'Enter ↵', value: 'enter', width: 128 },
    { label: 'PgDn', value: 'pagedown', width: 80 },
  ]),
  ...layoutRow(260, [
    { label: '⇧ Shift', value: 'shift', width: 140 },
    ...'ZXCVBNM'.split('').map((label) => ({ label, value: label.toLowerCase() })),
    { label: '<', value: ',' },
    { label: '>', value: '.' },
    { label: '?', value: '/' },
    { label: 'Shift ⇧', value: 'shift-right', width: 140 },
    { label: '↑', value: 'arrowup' },
  ]),
  ...layoutRow(320, [
    { label: 'Ctrl', value: 'control', width: 70 },
    { label: 'Meta', value: 'meta', width: 70 },
    { label: 'Alt', value: 'alt', width: 70 },
    { label: '', value: 'space', width: 410 },
    { label: 'Alt', value: 'alt-right', width: 70 },
    { label: 'Fn', value: 'fn', width: 70 },
    { label: 'Ctrl', value: 'control-right', width: 70 },
    { label: '←', value: 'arrowleft' },
    { label: '↓', value: 'arrowdown' },
    { label: '→', value: 'arrowright' },
  ]),
];
---

<svg
  class="mechanical-keyboard-svg"
  viewBox="0 0 1200 505"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <linearGradient id="hero-keyboard-spectrum" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ff3f38" />
      <stop offset=".18" stop-color="#ff9d2e" />
      <stop offset=".36" stop-color="#d8e83e" />
      <stop offset=".52" stop-color="#36e17d" />
      <stop offset=".68" stop-color="#28d9f5" />
      <stop offset=".84" stop-color="#5579ff" />
      <stop offset="1" stop-color="#d84fff" />
    </linearGradient>
    <linearGradient id="hero-keyboard-chassis" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3b4655" />
      <stop offset=".18" stop-color="#242d39" />
      <stop offset=".72" stop-color="#111821" />
      <stop offset="1" stop-color="#070b11" />
    </linearGradient>
    <linearGradient id="hero-keyboard-deck" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#111820" />
      <stop offset="1" stop-color="#03060a" />
    </linearGradient>
    <linearGradient id="hero-keyboard-key-top" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3c4652" />
      <stop offset=".2" stop-color="#303944" />
      <stop offset=".78" stop-color="#202730" />
      <stop offset="1" stop-color="#171d24" />
    </linearGradient>
    <linearGradient id="hero-keyboard-key-side" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#171d25" />
      <stop offset="1" stop-color="#05080d" />
    </linearGradient>
    <filter id="hero-keyboard-shadow" x="-20%" y="-20%" width="140%" height="170%">
      <feDropShadow dx="0" dy="20" stdDeviation="18" flood-color="#00040a" flood-opacity=".78" />
    </filter>
    <filter id="hero-keyboard-glow" x="-30%" y="-300%" width="160%" height="700%">
      <feGaussianBlur stdDeviation="19" />
    </filter>
  </defs>

  <g class="mechanical-keyboard-rgb-field">
    <rect class="mechanical-keyboard-ambient" x="82" y="390" width="1036" height="26" rx="13" fill="url(#hero-keyboard-spectrum)" filter="url(#hero-keyboard-glow)" />
  </g>

  <g filter="url(#hero-keyboard-shadow)">
    <path class="mechanical-keyboard-lower" d="M50 82Q50 54 78 54H1122Q1150 54 1150 82V389Q1150 418 1122 422H78Q50 418 50 389Z" />
    <rect class="mechanical-keyboard-body" x="50" y="53" width="1100" height="350" rx="22" fill="url(#hero-keyboard-chassis)" />
    <rect class="mechanical-keyboard-rim" x="59" y="62" width="1082" height="330" rx="15" />
    <rect class="mechanical-keyboard-deck" x="67" y="70" width="1066" height="310" rx="11" fill="url(#hero-keyboard-deck)" />
    <path class="mechanical-keyboard-top-line" d="M76 66H1124" />
    <path class="mechanical-keyboard-front-line" d="M72 393H1128" />
  </g>

  <g class="mechanical-keyboard-keys">
    {keys.map((key) => (
      <g transform={`translate(${key.x} ${key.y})`}>
        <g class="mechanical-key" data-key={key.value} style={`--key-rgb-hue: ${key.hue}`}>
          <rect class="mechanical-key-rgb" x="-2" y="3" width={key.width + 4} height={key.height + 3} rx="8" />
          <rect class="mechanical-key-side" x="0" y="5" width={key.width} height={key.height - 1} rx="7" fill="url(#hero-keyboard-key-side)" />
          <path
            class="mechanical-key-front"
            d={`M1 ${key.height - 14}H${key.width - 1}V${key.height - 6}Q${key.width - 1} ${key.height - 1} ${key.width - 7} ${key.height - 1}H7Q1 ${key.height - 1} 1 ${key.height - 6}Z`}
          />
          <path
            class="mechanical-key-top"
            d={`M7 0H${key.width - 7}Q${key.width - 1} 0 ${key.width - 1} 6V${key.height - 14}Q${key.width - 1} ${key.height - 7} ${key.width - 7} ${key.height - 7}H7Q1 ${key.height - 7} 1 ${key.height - 14}V6Q1 0 7 0Z`}
            fill="url(#hero-keyboard-key-top)"
          />
          <path class="mechanical-key-highlight" d={`M7 5H${key.width - 7}`} />
          {key.symbol ? (
            <text class="mechanical-key-label mechanical-key-label-dual" x={key.width / 2} y="16" text-anchor="middle">
              <tspan x={key.width / 2}>{key.symbol}</tspan>
              <tspan x={key.width / 2} dy="18">{key.label}</tspan>
            </text>
          ) : key.label ? (
            <text
              class:list={['mechanical-key-label', key.label.length > 5 && 'mechanical-key-label-small']}
              x={key.width / 2}
              y="29"
              text-anchor="middle"
            >
              {key.label}
            </text>
          ) : null}
        </g>
      </g>
    ))}
  </g>

  <g class="mechanical-keyboard-details" aria-hidden="true">
    <circle cx="68" cy="77" r="2" />
    <circle cx="1132" cy="77" r="2" />
    <circle cx="68" cy="379" r="2" />
    <circle cx="1132" cy="379" r="2" />
  </g>
</svg>
