---
import { profile } from '@/data/profile';

type Key = { label: string; value: string; size?: 'wide' | 'wider' | 'space' };

const rows: Key[][] = [
  [
    { label: 'esc', value: 'escape', size: 'wide' },
    ...'1234567890'.split('').map((value) => ({ label: value, value })),
    { label: 'delete', value: 'backspace', size: 'wider' },
  ],
  [
    { label: 'tab', value: 'tab', size: 'wide' },
    ...'QWERTYUIOP'.split('').map((value) => ({ label: value, value: value.toLowerCase() })),
    { label: '\\', value: '\\', size: 'wide' },
  ],
  [
    { label: 'caps', value: 'capslock', size: 'wider' },
    ...'ASDFGHJKL'.split('').map((value) => ({ label: value, value: value.toLowerCase() })),
    { label: 'return', value: 'enter', size: 'wider' },
  ],
  [
    { label: 'shift', value: 'shift', size: 'wider' },
    ...'ZXCVBNM'.split('').map((value) => ({ label: value, value: value.toLowerCase() })),
    { label: 'shift', value: 'shift-right', size: 'wider' },
  ],
  [
    { label: 'command', value: 'meta', size: 'wide' },
    { label: '', value: 'space', size: 'space' },
    { label: 'enter', value: 'enter-bottom', size: 'wide' },
  ],
];
---

<div class="typing-station manga-panel" data-typing-station data-name={profile.name} data-subtitle="Portfolio" aria-describedby="typing-station-description">
  <p id="typing-station-description" class="visually-hidden">An animated keyboard types {profile.name}, Portfolio, presses Enter, and opens the portfolio overview.</p>
  <div class="typing-station-label meta">
    <span>TYPEWRITER STRIP / 00</span>
    <button class="typing-replay" type="button" data-typing-replay aria-label="Replay the name typing animation">Replay ↻</button>
  </div>

  <div class="typing-display">
    <span class="typing-command meta" aria-hidden="true">portfolio.open()</span>
    <div class="typing-title" aria-hidden="true">
      <span class="typing-prompt" aria-hidden="true">›</span>
      <span class="typing-lines">
        <span data-typed-name>{profile.name}</span>
        <span class="typing-subtitle" data-typed-subtitle>Portfolio</span>
      </span>
      <span class="typing-cursor" aria-hidden="true"></span>
    </div>
    <button class="typing-enter" type="button" data-typing-enter aria-label="Open the portfolio overview now">
      <span class="typing-enter-key">Enter ↵</span>
      <span data-enter-label>Open Overview</span>
    </button>
    <div class="typing-readout meta" aria-hidden="true">
      <span data-typing-readout>INPUT / WAITING</span>
      <span>TYPE · CONFIRM · ENTER</span>
    </div>
    <p class="visually-hidden" aria-live="polite" data-typing-status></p>
  </div>

  <div class="keyboard" aria-hidden="true">
    {rows.map((row) => (
      <div class="keyboard-row">
        {row.map((key) => (
          <span class:list={['keyboard-key', key.size && `keyboard-key-${key.size}`]} data-key={key.value}>
            {key.label}
          </span>
        ))}
      </div>
    ))}
  </div>

  <div class="typing-station-caption">
    <span class="annotation-mark" aria-hidden="true">↳</span>
    <span>The sequence types the identity, confirms with Enter, then opens the overview.</span>
    <span class="meta">26 CHAR / ENTER</span>
  </div>
</div>

<script>
  const stations = Array.from(document.querySelectorAll<HTMLElement>('[data-typing-station]'));

  stations.forEach((station) => {
    const output = station.querySelector<HTMLElement>('[data-typed-name]');
    const subtitleOutput = station.querySelector<HTMLElement>('[data-typed-subtitle]');
    const replay = station.querySelector<HTMLButtonElement>('[data-typing-replay]');
    const enter = station.querySelector<HTMLButtonElement>('[data-typing-enter]');
    const enterLabel = station.querySelector<HTMLElement>('[data-enter-label]');
    const readout = station.querySelector<HTMLElement>('[data-typing-readout]');
    const status = station.querySelector<HTMLElement>('[data-typing-status]');
    const gate = station.closest<HTMLElement>('[data-hero-gate]');
    const overview = gate?.querySelector<HTMLElement>('[data-overview-content]');
    const name = station.dataset.name ?? '';
    const subtitle = station.dataset.subtitle ?? '';
    const sequence = `${name}\n${subtitle}`;
    const typingStartDelay = 250;
    const characterDelay = 125;
    const completedTitleHold = 1200;
    const enterPressHold = 250;
    const root = document.documentElement;
    const introStorageKey = root.dataset.introStorageKey;
    const isStaticPreview = root.dataset.introDebug === 'true';
    const isReturningVisitor = root.dataset.introVisit === 'returning';
    let timers: number[] = [];
    let hasPlayed = false;

    const clearTimers = () => {
      timers.forEach((timer) => window.clearTimeout(timer));
      timers = [];
      station.querySelectorAll('.is-pressed').forEach((key) => key.classList.remove('is-pressed'));
      station.removeAttribute('data-enter-state');
    };

    const openOverview = (focusHeading = false) => {
      if (!gate || !overview || gate.dataset.introState === 'entered') return;
      clearTimers();
      try {
        if (introStorageKey) localStorage.setItem(introStorageKey, 'seen');
      } catch { /* Storage may be disabled. */ }
      gate.dataset.introState = 'exiting';
      const finish = () => {
        gate.dataset.introState = 'entered';
        if (!focusHeading) return;
        const heading = overview.querySelector<HTMLElement>('h2');
        heading?.setAttribute('tabindex', '-1');
        heading?.focus({ preventScroll: true });
      };
      if (document.documentElement.dataset.motion === 'reduced') finish();
      else timers.push(window.setTimeout(finish, 260));
    };

    const pressEnterAndOpen = () => {
      if (gate?.dataset.introState === 'entered') return;
      station.dataset.typingState = 'confirming';
      station.dataset.enterState = 'pressed';
      if (enterLabel) enterLabel.textContent = 'Opening Overview';
      if (readout) readout.textContent = 'INPUT / ENTER';
      if (status) status.textContent = 'Enter pressed. Opening the portfolio overview.';
      station.querySelectorAll<HTMLElement>('[data-key="enter"], [data-key="enter-bottom"]').forEach((key) => key.classList.add('is-pressed'));
      timers.push(window.setTimeout(() => openOverview(), enterPressHold));
    };

    const showCompleteTitle = (autoAdvance = true) => {
      clearTimers();
      if (output) output.textContent = name;
      if (subtitleOutput) subtitleOutput.textContent = subtitle;
      station.dataset.typingState = 'complete';
      if (enterLabel) enterLabel.textContent = 'Open Overview';
      if (readout) readout.textContent = 'INPUT / COMPLETE';
      if (status) status.textContent = autoAdvance
        ? 'Typing complete. Enter will be pressed automatically.'
        : 'Typing animation skipped. Activate Open Overview to continue.';
      if (gate?.dataset.introState !== 'entered') gate?.setAttribute('data-intro-state', 'active');
      if (autoAdvance) timers.push(window.setTimeout(pressEnterAndOpen, completedTitleHold));
    };

    const showStaticPreview = () => {
      showCompleteTitle(false);
      station.dataset.staticPreview = 'true';
      if (readout) readout.textContent = 'PREVIEW / STATIC';
      if (status) status.textContent = 'Static intro preview. The Overview transition is disabled in development.';
    };

    const previewEnterPress = () => {
      clearTimers();
      station.dataset.typingState = 'confirming';
      station.dataset.enterState = 'pressed';
      if (readout) readout.textContent = 'PREVIEW / ENTER';
      station.querySelectorAll<HTMLElement>('[data-key="enter"], [data-key="enter-bottom"]').forEach((key) => key.classList.add('is-pressed'));
      timers.push(window.setTimeout(() => {
        station.querySelectorAll('.is-pressed').forEach((key) => key.classList.remove('is-pressed'));
        station.removeAttribute('data-enter-state');
        station.dataset.typingState = 'complete';
        if (readout) readout.textContent = 'PREVIEW / STATIC';
      }, enterPressHold));
    };

    const play = () => {
      if (!output || !subtitleOutput || document.documentElement.dataset.motion === 'reduced') {
        showCompleteTitle();
        return;
      }

      clearTimers();
      hasPlayed = true;
      output.textContent = '';
      subtitleOutput.textContent = '';
      station.dataset.typingState = 'typing';
      gate?.setAttribute('data-intro-state', 'active');
      if (readout) readout.textContent = 'INPUT / TYPING';
      if (status) status.textContent = 'Typing Aaditya Bhatnagar, Portfolio.';
      let currentOutput = output;

      Array.from(sequence).forEach((character, index) => {
        const timer = window.setTimeout(() => {
          if (character === '\n') currentOutput = subtitleOutput;
          else currentOutput.textContent += character;
          const keyValue = character === '\n' ? 'enter' : character === ' ' ? 'space' : character.toLowerCase();
          const key = station.querySelector<HTMLElement>(`[data-key="${keyValue}"]`);
          key?.classList.add('is-pressed');
          const releaseTimer = window.setTimeout(() => key?.classList.remove('is-pressed'), 115);
          timers.push(releaseTimer);

          if (index === sequence.length - 1) showCompleteTitle();
        }, typingStartDelay + index * characterDelay);
        timers.push(timer);
      });
    };

    station.dataset.enhanced = 'true';
    if (isStaticPreview) {
      enter?.addEventListener('click', previewEnterPress);
      showStaticPreview();
      return;
    }

    if (isReturningVisitor) {
      gate?.setAttribute('data-intro-state', 'entered');
      return;
    }

    replay?.addEventListener('click', play);
    enter?.addEventListener('click', () => openOverview(true));
    window.addEventListener('motionchange', () => {
      if (gate?.dataset.introState === 'entered') return;
      if (document.documentElement.dataset.motion === 'reduced') {
        showCompleteTitle(false);
      }
      else play();
    });

    if (document.documentElement.dataset.motion === 'reduced') {
      showCompleteTitle(false);
    } else {
      if (output) output.textContent = '';
      if (subtitleOutput) subtitleOutput.textContent = '';
      station.dataset.typingState = 'waiting';
      gate?.setAttribute('data-intro-state', 'active');
    }

    if (document.documentElement.dataset.motion !== 'reduced' && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting) || hasPlayed) return;
        play();
        observer.disconnect();
      }, { threshold: .01 });
      observer.observe(station);
    } else if (document.documentElement.dataset.motion !== 'reduced') {
      play();
    }
  });
</script>
