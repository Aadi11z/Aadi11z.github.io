---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PositioningSection from '@/components/PositioningSection.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ResearchEntry from '@/components/ResearchEntry.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import CapabilitiesSection from '@/components/CapabilitiesSection.astro';
import MetricsLedger from '@/components/MetricsLedger.astro';
import ContactSection from '@/components/ContactSection.astro';
import { featuredProjects } from '@/data/projects';
import { research } from '@/data/research';
import { withBase } from '@/data/site';
import '@/styles/home.css';
import '@/styles/projects.css';
import '@/styles/research.css';
---

<BaseLayout layout="deck">
  <div class="home-deck" data-section-deck data-default-section="overview">
    <div class="deck-panel" id="overview" data-deck-panel role="region" aria-labelledby="hero-title">
      <Hero />
    </div>

    <section class="deck-panel section shell" id="work" data-deck-panel aria-labelledby="work-title">
      <SectionHeading id="work-title" index="01 / Work" title="Selected work" description="Research and engineering projects across grounded AI, machine learning, quantitative systems, and data platforms." />
      <div class="projects-grid">
        {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="section-action"><a class="text-link" href={withBase('/projects/')}>Open the complete project archive</a></div>
    </section>

    <section class="deck-panel section research-section" id="research" data-deck-panel aria-labelledby="research-title">
      <div class="shell">
        <SectionHeading id="research-title" index="02 / Research" title="Research notes" description="I’m interested in reliable machine learning, selective forgetting, robustness, and evaluation." />
        <div class="research-list">
          {research.map((entry, index) => <ResearchEntry entry={entry} index={index} />)}
        </div>
      </div>
    </section>

    <section class="deck-panel section shell experience-section" id="experience" data-deck-panel aria-labelledby="experience-title">
      <SectionHeading id="experience-title" index="03 / Experience" title="Production experience" description="Forecasting, data automation, scenario analysis, and internal machine-learning tooling for regional planning workflows." />
      <ExperienceTimeline />
    </section>

    <div class="deck-panel" id="about" data-deck-panel role="region" aria-labelledby="positioning-title">
      <PositioningSection />
      <CapabilitiesSection />
      <MetricsLedger />
    </div>

    <div class="deck-panel" id="contact" data-deck-panel role="region" aria-labelledby="contact-title">
      <ContactSection />
    </div>
  </div>
  <script>
    import '@/scripts/section-deck';
  </script>
</BaseLayout>
