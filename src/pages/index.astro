---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import PaperCard from '@/components/PaperCard.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import { featuredProjectGroups } from '@/data/projects';
import { papers, research } from '@/data/research';
import { withBase } from '@/data/site';
import '@/styles/home.css';
import '@/styles/hero.css';
import '@/styles/projects.css';
import '@/styles/research.css';
---

<BaseLayout layout="deck">
  <div class="home-deck" data-section-deck data-default-section="overview">
    <div class="deck-panel" id="overview" data-deck-panel role="region" aria-labelledby="hero-title">
      <Hero />
    </div>

    <section class="deck-panel section shell" id="projects" data-deck-panel aria-labelledby="projects-title">
      <SectionHeading id="projects-title" index="01 / Projects" title="Selected projects" description="A focused set of AI, machine-learning, software, quantitative, and data systems." />
      <div class="topic-index" role="list" aria-label="Project topics">
        {featuredProjectGroups.map((group) => <span class="topic-index-item" role="listitem">{group.category}<small>{String(group.projects.length).padStart(2, '0')}</small></span>)}
      </div>
      <div class="project-groups project-groups-featured">
        {featuredProjectGroups.map((group) => (
          <section class="project-topic" id={`project-topic-${group.category.toLowerCase().replaceAll(' ', '-')}`} aria-labelledby={`project-topic-title-${group.category.toLowerCase().replaceAll(' ', '-')}`}>
            <header class="project-topic-header">
              <h3 id={`project-topic-title-${group.category.toLowerCase().replaceAll(' ', '-')}`}>{group.category}</h3>
              <span class="meta">{String(group.projects.length).padStart(2, '0')} selected</span>
            </header>
            <div class="project-card-grid">
              {group.projects.map((project) => <ProjectCard project={project} index={featuredProjectGroups.flatMap((item) => item.projects).indexOf(project)} headingLevel={4} />)}
            </div>
          </section>
        ))}
      </div>
      <div class="section-action"><a class="text-link" href={withBase('/projects/')}>Open the complete project archive</a></div>
    </section>

    <section class="deck-panel section research-section" id="research" data-deck-panel aria-labelledby="research-title">
      <div class="shell">
        <SectionHeading id="research-title" index="02 / Research" title="Research in practice" description="Research projects and the primary papers that inform their implementations." />
        <section class="research-cluster" aria-labelledby="research-projects-title">
          <div class="cluster-heading"><span class="eyebrow">Research projects</span><h3 id="research-projects-title">Experiments and evaluation</h3></div>
          <div class="research-card-grid">
            {research.map((entry, index) => <ResearchCard entry={entry} index={index} headingLevel={4} />)}
          </div>
        </section>
        <section class="research-cluster" aria-labelledby="papers-title">
          <div class="cluster-heading"><span class="eyebrow">Paper library</span><h3 id="papers-title">Papers behind the implementation</h3></div>
          <div class="paper-card-grid">
            {papers.map((paper, index) => <PaperCard paper={paper} index={index} headingLevel={4} />)}
          </div>
        </section>
      </div>
    </section>

    <section class="deck-panel section shell experience-section" id="experience" data-deck-panel aria-labelledby="experience-title">
      <SectionHeading id="experience-title" index="03 / Experience" title="Professional experience" description="Production-facing machine learning, forecasting, and tooling—summarized from my public LinkedIn experience note." />
      <ExperienceTimeline />
    </section>
  </div>
  <script>
    import '@/scripts/section-deck';
  </script>
</BaseLayout>
