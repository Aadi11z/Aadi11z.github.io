---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/data/site';
---

<BaseLayout title="Resume — Aaditya Bhatnagar" description="Resume and professional background for Aaditya Bhatnagar.">
  <section class="resume-panel shell">
    <div class="resume-card">
      <div class="resume-card-mark" aria-hidden="true">AB</div>
      <div class="resume-card-copy">
        <span class="eyebrow">Public résumé / PDF</span>
        <h1>Aaditya Bhatnagar</h1>
        <p>The downloadable résumé preserves the supplied professional content while redacting the private phone number. The original source CV remains outside the deployable repository.</p>
        <div class="button-row resume-actions">
          <a class="button button-primary" href={withBase('/Aaditya_Bhatnagar_Resume.pdf')} download>Download résumé <span aria-hidden="true">↓</span></a>
          <a class="button button-quiet" href={withBase('/')}>Back to home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
