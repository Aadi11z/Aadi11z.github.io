---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { projectGroups, projects } from '@/data/projects';
import '@/styles/projects.css';
---

<BaseLayout title="Projects — Aaditya Bhatnagar" description="Technical projects and research by Aaditya Bhatnagar across AI engineering, machine learning, forecasting, quantitative research, computer vision, and software systems.">
  <section class="page-hero shell">
    <div class="page-hero-index"><span class="eyebrow">Projects</span><span class="meta">{String(projects.length).padStart(2, '0')} records / 05 topics</span></div>
    <h1>Projects, grouped<br />by <em>practice.</em></h1>
    <div class="page-hero-copy">
      <p>A working archive of technical projects and research systems across AI, machine learning, software development, quantitative work, and data.</p>
      <p class="meta">BROWSE / INSPECT / OPEN CASE FILE</p>
    </div>
  </section>
  <section class="shell archive-section" aria-labelledby="archive-title">
    <SectionHeading id="archive-title" index="Index / All projects" title="Five working areas" description="Each project appears once under its primary topic; secondary areas remain visible on the card." />
    <nav class="topic-index topic-index-archive" aria-label="Project topics">
      {projectGroups.map((group) => <a href={`#${group.category.toLowerCase().replaceAll(' ', '-')}`}><span>{group.category}</span><strong>{String(group.projects.length).padStart(2, '0')}</strong></a>)}
    </nav>
    <div class="project-groups">
      {projectGroups.map((group) => (
        <section class="project-topic" id={group.category.toLowerCase().replaceAll(' ', '-')} aria-labelledby={`${group.category.toLowerCase().replaceAll(' ', '-')}-title`}>
          <header class="project-topic-header">
            <h2 id={`${group.category.toLowerCase().replaceAll(' ', '-')}-title`}>{group.category}</h2>
            <p>{String(group.projects.length).padStart(2, '0')} {group.projects.length === 1 ? 'project' : 'projects'}</p>
          </header>
          <div class="project-card-grid">
            {group.projects.map((project) => <ProjectCard project={project} index={projects.indexOf(project)} variant="archive" />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
