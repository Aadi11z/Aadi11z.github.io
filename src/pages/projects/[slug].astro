---
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import { detailProjects } from '@/data/projects';

export function getStaticPaths() {
  return detailProjects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: detailProjects[index - 1],
      next: detailProjects[index + 1],
    },
  }));
}

const { project, previous, next } = Astro.props;
if (!project) throw new Error('Project detail data is required for this static route.');
---

<ProjectLayout project={project} previous={previous} next={next} />
