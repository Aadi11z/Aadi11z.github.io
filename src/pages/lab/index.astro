---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UnlearningExplorer from '@/components/playgrounds/UnlearningExplorer.astro';
import { withBase } from '@/data/site';
import '@/styles/projects.css';
import '@/styles/playgrounds.css';
---

<BaseLayout title="Lab — Aaditya Bhatnagar" description="Small interactive experiments and technical visualizations from Aaditya Bhatnagar's portfolio.">
  <section class="page-hero shell">
    <div class="page-hero-index"><span class="eyebrow">Experimental index</span><span class="meta">Static data / Native browser APIs</span></div>
    <h1>Technical ideas,<br /><em>made inspectable.</em></h1>
    <div class="page-hero-copy"><p>The lab isolates interactive experiments from the recruiter-facing portfolio. Every experiment must remain accessible, lightweight, and useful without requiring a backend.</p><p class="meta">NO LIVE INFERENCE / NO HIDDEN DATA</p></div>
  </section>
  <div class="shell lab-page">
    <div class="lab-intro-grid">
      <div><span class="eyebrow">Lab rule 01</span><p class="lede">Interactivity should clarify a technical decision or evaluation trade-off—not act as decoration.</p></div>
      <aside class="lab-principles manga-panel"><span class="meta">Operating constraints</span><ul><li>Static, typed local data</li><li>Keyboard-accessible controls</li><li>Written fallback summaries</li><li>Reduced-motion support</li></ul></aside>
    </div>
    <UnlearningExplorer />
    <div class="lab-shelf" aria-label="Future experiments">
      <article class="manga-panel"><span class="meta">Queued / 01</span><h2>Neural-network visualizer</h2><p>A compact inspection surface for the 2-4-1 Rust MLP, reserved until real exported model states are supplied.</p></article>
      <article class="manga-panel"><span class="meta">Queued / 02</span><h2>Retrieval explorer</h2><p>A GroundDesk evidence-path view for comparing retrieved passages, citations, and escalation decisions.</p></article>
      <article class="manga-panel"><span class="meta">Queued / 03</span><h2>Market storyboard</h2><p>A future temporal-validation sequence for forecasts and point-in-time quantitative signals.</p></article>
    </div>
    <p><a class="text-link" href={withBase('/')}>Return to the main portfolio</a></p>
  </div>
</BaseLayout>
